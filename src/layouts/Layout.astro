---
import "../styles/global.css";
// import { ClientRouter } from "astro:transitions";
import Header from "./components/Header.astro";
import Footer from "./components/Footer.astro";

interface Props {
  title: string | undefined;
  description?: string | undefined;
  robots?: string | undefined;
}

const {
  title = "",
  description = "PokéCards",
  robots = "index, follow",
} = Astro.props;

let titulo = title?.toString();
if (titulo?.length > 0) titulo += " - ";
titulo += "PokéCards";
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#13151a" />

    <link rel="icon" href="/img/icon/pokecards_icon.webp" />
    <link rel="canonical" href={Astro.url.href} />

    <title>{titulo}</title>
    <meta name="description" content={description} />

    <link rel="apple-touch-icon" href="/img/icon/pokecards_icon.webp" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />

    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="robots" content={robots} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content="/img/pwa-192x192.png" />
    <meta property="og:site_name" content="PokéCards" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "PokéCards",
        "url": "https://pokecards.jbr1989.es",
        "logo": "https://pokecards.jbr1989.es/img/pwa-192x192.png",
        "description": "Explora y gestiona tu colección de cartas Pokémon TCG"
      }
    </script>

    <!-- <ClientRouter /> -->

    <link rel="stylesheet" href="css/main.css">

    <script
      type="module"
      data-entity="pokecards"
      src="https://info.jbr1989.es/script.js"></script>
  </head>
  <body>
    <div class="flex min-h-screen flex-col">
      <Header />
      <slot />
      <Footer />
    </div>
    <script>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {});
        });
      }
    </script>
  </body>
</html>
